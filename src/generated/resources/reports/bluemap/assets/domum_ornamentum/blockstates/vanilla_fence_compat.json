{
  "multipart": [
    {
      "apply": {
        "model": "domum_ornamentum:block/fence/fence_post",
        "renderer": "domum_ornamentum:materially_retexturable"
      }
    },
    {
      "apply": {
        "model": "domum_ornamentum:block/fence/fence_side",
        "renderer": "domum_ornamentum:materially_retexturable"
      },
      "when": {
        "north": "true"
      }
    },
    {
      "apply": {
        "model": "domum_ornamentum:block/fence/fence_side",
        "renderer": "domum_ornamentum:materially_retexturable",
        "y": 180
      },
      "when": {
        "south": "true"
      }
    },
    {
      "apply": {
        "model": "domum_ornamentum:block/fence/fence_side",
        "renderer": "domum_ornamentum:materially_retexturable",
        "y": 270
      },
      "when": {
        "west": "true"
      }
    },
    {
      "apply": {
        "model": "domum_ornamentum:block/fence/fence_side",
        "renderer": "domum_ornamentum:materially_retexturable",
        "y": 90
      },
      "when": {
        "east": "true"
      }
    }
  ]
}